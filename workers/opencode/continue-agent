#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────────────────────
# Predefined agent continue script.
#
# The control plane runs THIS over `docker exec` when the user opens a session's
# interactive "agent" terminal. Its one job: resume the harness you installed in
# worker/Dockerfile in a tmux session, attached to the PTY, so the user can keep
# working after closing or refreshing the browser tab.
#
# Swapping harness? Change the launch line below to your harness's interactive
# resume command, and update start-agent + worker/Dockerfile to match. Nothing in
# the control plane changes — it only knows "run this script".
# ─────────────────────────────────────────────────────────────────────────────
set -euo pipefail

# Default harness: opencode. `opencode --continue` resumes the most recent
# session interactively in the current working directory. tmux keeps it running
# when the browser WebSocket disconnects; the next attach reconnects to it.
exec tmux new-session -A -s sagewright-agent "exec opencode --continue"
