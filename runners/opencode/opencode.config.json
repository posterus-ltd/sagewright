{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-5.3-codex",
  "mcp": {
    "sagewright": {
      "type": "remote",
      "url": "{env:SAGEWRIGHT_MCP_URL}",
      "enabled": true,
      "headers": {
        "Authorization": "Bearer {env:SAGEWRIGHT_MCP_TOKEN}"
      }
    }
  }
}
