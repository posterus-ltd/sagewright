#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────────────────────
# Predefined agent start script.
#
# The control plane runs THIS over `docker exec` to launch the agent for the
# session's first turn. SESSION_MODE picks the mode:
#   - interactive: no prompt — drop straight into the harness, live, in the
#     `sagewright-agent` tmux session so a later browser attach (continue-agent)
#     reattaches to this same running conversation instead of starting a new one.
#   - headless (default): start the harness you installed in runner/Dockerfile
#     against "$PROMPT" in the current working directory, in the foreground, and
#     exit when the agent is done. The exit code decides the task outcome (0 → DONE).
# Everything the agent prints is streamed back as the live transcript.
#
# Swapping harness? Change the launch lines below to start your harness, and
# update the install steps in runner/Dockerfile. Nothing in the control plane
# changes — it only knows "run this script".
# ─────────────────────────────────────────────────────────────────────────────
set -euo pipefail

# Point Codex's built-in Sagewright MCP server at the url the control plane injected.
# Codex reads the bearer from an env var but not the url, so rewrite the static line in
# the baked config to match SAGEWRIGHT_MCP_URL — this keeps codex consistent with the
# other runners when MCP_PUBLIC_URL is overridden. No-op when the var is unset (MCP off).
CODEX_CONFIG="/root/.codex/config.toml"
if [ -n "${SAGEWRIGHT_MCP_URL:-}" ] && [ -f "$CODEX_CONFIG" ]; then
  sed -i "s|^url = .*|url = \"${SAGEWRIGHT_MCP_URL}\"|" "$CODEX_CONFIG"
fi

if [ "${SESSION_MODE:-headless}" = "interactive" ]; then
  exec tmux new-session -A -s sagewright-agent "exec codex --dangerously-bypass-approvals-and-sandbox"
fi

PROMPT_TEXT="${PROMPT:-}"

# Prepend the baked alignment / system prompt, if present.
SOUL_FILE="/etc/sagewright/SOUL.md"
if [ -f "$SOUL_FILE" ]; then
  PROMPT_TEXT="$(cat "$SOUL_FILE")

${PROMPT_TEXT}"
fi

# Harness: Codex. `codex exec` runs one task non-interactively and prints its
# work to the terminal (which the control plane records as the transcript). The
# container is the sandbox, so approvals and Codex's own sandbox are bypassed.
exec codex exec "$PROMPT_TEXT" --dangerously-bypass-approvals-and-sandbox
