#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────────────────────
# Predefined agent continue script.
#
# The control plane runs THIS over `docker exec` when the user opens a session's
# interactive "agent" terminal. Its one job: resume the harness you installed in
# runner/Dockerfile in a tmux session, attached to the PTY, so the user can keep
# working after closing or refreshing the browser tab.
#
# Swapping harness? Change the launch line below to your harness's interactive
# resume command, and update start-agent + runner/Dockerfile to match. Nothing in
# the control plane changes — it only knows "run this script".
# ─────────────────────────────────────────────────────────────────────────────
set -euo pipefail

# Sync Codex's built-in Sagewright MCP server url with the one the control plane injected
# (codex can't read the url from env, only the bearer). Mirrors start-agent so a resumed
# interactive session reaches /mcp at the same address; no-op when the var is unset.
CODEX_CONFIG="/root/.codex/config.toml"
if [ -n "${SAGEWRIGHT_MCP_URL:-}" ] && [ -f "$CODEX_CONFIG" ]; then
  sed -i "s|^url = .*|url = \"${SAGEWRIGHT_MCP_URL}\"|" "$CODEX_CONFIG"
fi

# Harness: Codex. `codex resume --last` resumes the most recent session
# interactively in the current working directory. tmux keeps it running when the
# browser WebSocket disconnects; the next attach reconnects to it.
exec tmux new-session -A -s sagewright-agent "exec codex resume --last --dangerously-bypass-approvals-and-sandbox"
