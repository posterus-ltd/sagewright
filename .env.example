# Control plane
# --- Postgres / database ---
# Credentials for the bundled Postgres container. Compose uses these to BOTH
# initialize the database AND build the control-plane's DATABASE_URL, so changing
# the username / password / db name here is respected end-to-end — there is no
# second place to keep in sync. Defaults match the values baked into docker-compose.yml.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=sage
# Optional escape hatch: point the control-plane at an EXTERNAL Postgres. When set,
# this full connection string overrides the URL built from the vars above (the
# bundled `postgres` container is then unused). The auto-built URL embeds the
# password verbatim, so if yours contains URL-reserved characters (@ : / ? #), set
# DATABASE_URL here explicitly with them percent-encoded.
# DATABASE_URL=postgres://user:pass@db.example.com:5432/sage
# Initial password for the seeded `root` account. You log in as `root` with this on
# first boot and are then forced to change it. (Renamed from APP_PASSWORD; the old
# name is still honored for one release.)
ROOT_PASSWORD=changeme
SESSION_SECRET=change-this-32-byte-secret-value!!
# Exactly 32 chars. Encrypts each user's custom per-session .env blob at rest
# (aes-256-gcm). Read by the control-plane at runtime; rotating it makes existing
# stored blobs undecryptable, so users must re-enter them.
SECRETS_KEY=change-this-32-char-secrets-key!
RUNNER_IMAGE=sagewright-runner-opencode:latest
# Image no-agent shell/CLI widget sessions run on (the agent's spawn_shell MCP tool, and
# any "terminal" widget on the canvas). A basic box with tmux + common CLI tools and no
# harness — build it with `scripts/build-runners.sh`. Defaults to the bundled shell runner.
# CLI_RUNNER_IMAGE=sagewright-runner-shell:latest
# Docker network the spawner attaches each runner container to. Must match the
# compose network name (see docker-compose.yml).
RUNNER_NETWORK=sagewright
PORT=3001
# Advertised URL of the control plane's MCP endpoint, injected into every runner as
# SAGEWRIGHT_MCP_URL so an agent can call back to spawn sessions, schedule jobs, and
# create workflows as its own user. Defaults to the in-cluster Docker-DNS address; only
# override if the control plane is reachable at a different internal host/port. The
# endpoint is internal-only (no published port) and every call requires the per-session
# token the control plane mints and injects — there is no other way in.
# MCP_PUBLIC_URL=http://control-plane:3001/mcp
# Whether archived sessions may be permanently deleted. Set to false on
# deployments that must retain session history for auditing — archiving still
# works, but the delete endpoint refuses and the web UI is built without the
# delete button (it's baked in at image build time, so changing it requires a
# rebuild). Accepts only true/false; anything else fails at boot. Defaults to true.
ALLOW_SESSION_DELETION=true
# Optional: host port for the self-signed-HTTPS sidecar (see "Installing as a PWA"
# in the README). Only used if you run `docker compose --profile https up`.
HTTPS_PORT=8443

# In the env shared across the org vars can be set and configured
# Those still need to be manually passed to the individual runner containers (within the `docker-compose.yml` ), but this is a convenient place to store them for now.
# Runner build args — the GLOBAL/org defaults, baked into the runner image at
# build time (`docker compose --profile build build`) and shared by every user's
# sessions. The runner reads these from its own process.env to clone/push via
# GitHub, authenticate npm, and run the opencode agent. They are NOT used by the
# control-plane. Note: baked tokens are visible in `docker history`, and rotating
# one requires rebuilding the runner image.
# Each user can override these (and add their own vars) at runtime in the web UI
# under Settings → Environment — those are encrypted with SECRETS_KEY and applied
# only to that user's sessions, no rebuild needed.
NODE_AUTH_TOKEN=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
