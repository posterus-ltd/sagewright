# Control plane
DATABASE_URL=postgres://postgres:postgres@localhost:5432/sage
APP_PASSWORD=changeme
SESSION_SECRET=change-this-32-byte-secret-value!!
# Exactly 32 chars. Encrypts each user's custom per-session .env blob at rest
# (aes-256-gcm). Read by the control-plane at runtime; rotating it makes existing
# stored blobs undecryptable, so users must re-enter them.
SECRETS_KEY=change-this-32-char-secrets-key!
# Optional: only needed for the Linear task source. Read by the control-plane at runtime.
LINEAR_API_KEY=
CONTROL_PLANE_URL=http://control-plane:3000
WORKER_IMAGE=sagewright-worker-opencode:latest
# Docker network worker containers join so the `control-plane` hostname resolves
# for /internal/* calls. Must match the compose network name (see docker-compose.yml).
WORKER_NETWORK=sagewright
PORT=3000
# Optional: host port for the self-signed-HTTPS sidecar (see "Installing as a PWA"
# in the README). Only used if you run `docker compose --profile https up`.
HTTPS_PORT=8443

# Worker build args — the GLOBAL/org defaults, baked into the worker image at
# build time (`docker compose --profile build build`) and shared by every user's
# sessions. The worker reads these from its own process.env to clone/push via
# GitHub, authenticate npm, and run the opencode agent. They are NOT used by the
# control-plane. Note: baked tokens are visible in `docker history`, and rotating
# one requires rebuilding the worker image.
# Each user can override these (and add their own vars) at runtime in the web UI
# under Settings → Environment — those are encrypted with SECRETS_KEY and applied
# only to that user's sessions, no rebuild needed.
GITHUB_TOKEN=
NODE_AUTH_TOKEN=
# Read by the opencode and codex harnesses inside their workers. opencode
# auto-detects the OpenAI provider from this and selects a default model; codex
# talks to the OpenAI API directly. Required for those agents to do any work —
# without it the worker no-ops and opens an empty PR.
OPENAI_API_KEY=
# Read by the claude-code and pi harnesses inside their workers. Both talk to the
# Anthropic API directly. Required for those agents to do any work.
ANTHROPIC_API_KEY=
